# --- Database ---
DB_HOST=teklesawiros-db-teklesawiros-db.d.aivencloud.com
DB_PORT=25038
DB_NAME=defaultdb
DB_USERNAME=avnadmin
DB_PASSWORD=your_password_here

# --- Server ---
PORT=8080

# --- Initial superadmin (seeded once, on first run, if no admins exist yet) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# --- CORS: comma-separated list of allowed frontend origins ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173,https://teklesawiros.netlify.app,https://teklesawiros.vercel.app
