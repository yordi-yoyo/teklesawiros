# Copy this file to .env and fill in real values. Never commit the real .env.

# --- Database ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=religious_db
DB_USERNAME=root
DB_PASSWORD=

# --- Server ---
PORT=8080

# --- Initial superadmin (seeded once, on first run, if no admins exist yet) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# --- CORS: comma-separated list of allowed frontend origins ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173,https://teklesawiros.netlify.app